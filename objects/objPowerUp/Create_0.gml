// Tipo de ayuda: lo asigna scrAplicarTipoAyuda justo después de crearla
tipo = AYUDA_ESCUDO;

// Frames que le quedan antes de desaparecer
vida = AYUDA_VIDA_PANTALLA;

// Flota lentamente en una dirección al azar
speed = AYUDA_VELOCIDAD;
direction = random(360);

// Contador para el latido del aro
latido = random(360);
